# ===== LLM(OpenAI 兼容协议;默认 DeepSeek,可换通义千问/智谱/OpenAI 等)=====
# 密钥请勿写在本文件:用系统环境变量注入,变量名 LLM_API_KEY 或 DEEPSEEK_API_KEY 皆可
# (Windows: setx DEEPSEEK_API_KEY "sk-xxx"),或在 PyCharm 运行配置的「环境变量」中添加。
# 环境变量优先于本文件,未设置时才回退到这里。
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 对话温度(0.7~0.9 更活泼)/ 生成类温度(0.3~0.5 更稳定)
CHAT_TEMPERATURE=0.8
GEN_TEMPERATURE=0.4

# 数据库(SQLite)
DATABASE_URL=sqlite:///./english_learning.db

# CORS 允许来源(逗号分隔;本地开发默认 "*",独立部署前端时收紧,如 http://localhost:5173)
CORS_ORIGINS=*

# 认证与邮件(Resend)
# 密钥请勿写在本文件:用系统环境变量注入 RESEND_API_KEY(与 LLM 密钥同一约定);
# 未配置时注册/登录仍可用,仅密码重置邮件不可用
# 测试模式发信地址固定用 onboarding@resend.dev(只能发给 Resend 账号本人邮箱);
# 域名验证后改为自有地址,如 no-reply@your-domain.com(见 docs/resend-tencent-dns.md)
RESEND_FROM=onboarding@resend.dev
# 密码重置邮件里的链接前缀(部署后改为 https://你的域名)
FRONTEND_URL=http://localhost:5173
